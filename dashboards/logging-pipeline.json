      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod, name) (fluentbit_input_storage_chunks{job=\"fluent-bit\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} {{name}}",
          "refId": "A",
          "range": true,
          "instant": false
